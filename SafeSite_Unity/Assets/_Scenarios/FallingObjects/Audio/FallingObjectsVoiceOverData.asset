    romanianAudio: {fileID: 0}
  - id: first_teleport
    englishSubtitles: Teleport to the blue spot you see on the ground
    englishAudio: {fileID: 8300000, guid: 9c06b3b2725a4654b8466adc01782d9c, type: 3}
    romanianSubtitles: 
    romanianAudio: {fileID: 0}
  - id: second_teleport
    englishSubtitles: Yeah Straight ahead, can you see it?
    englishAudio: {fileID: 8300000, guid: 9c06b3b2725a4654b8466adc01782d9c, type: 3}
    romanianSubtitles: 
    romanianAudio: {fileID: 0}
  - id: grab_drill
    englishSubtitles: Now with your free hand, reach out and grab the drill
    englishAudio: {fileID: 8300000, guid: 9c06b3b2725a4654b8466adc01782d9c, type: 3}
